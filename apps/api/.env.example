# local dev (docker-compose.dev.yml)
DATABASE_ADMIN_URL=postgres://postgres:devpass@127.0.0.1:5433/prakai
DATABASE_URL=postgres://prakai_app:apppass@127.0.0.1:5433/prakai
APP_DB_PASSWORD=apppass
JWT_SECRET=change-me-to-openssl-rand-hex-48
PORT=4000
# Operator emails (comma separated) allowed to review sign-ups at /platform; empty = nobody
PLATFORM_ADMIN_EMAILS=

